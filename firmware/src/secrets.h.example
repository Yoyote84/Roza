// ROZA — exemple de configuration des services externes.
// Copier ce fichier sous le nom secrets.h dans firmware/src/.
// Le vrai fichier secrets.h est ignoré par Git : NE JAMAIS le publier.
// Après modification, reconstruire puis reflasher ROZA_UPDATE.bin à 0x10000.
// Les clés sont intégrées au firmware compilé ; elles ne sont pas saisissables
// depuis l'interface du Cardputer dans cette version.

#pragma once

// ChatGPT / API compatible OpenAI
// Exemple : https://api.openai.com/v1
#define CHAT_BASE_URL "https://api.openai.com/v1"
#define CHAT_API_KEY "COLLER_VOTRE_CLE_API_ICI"
#define CHAT_MODEL "gpt-4o-mini"

// Laisser vide pour utiliser le bundle de certificats racines intégré.
// Ne pas activer CHAT_ALLOW_INSECURE en usage normal.
#define CHAT_ROOT_CA ""
#define CHAT_ALLOW_INSECURE false

// Nom du compte GitHub utilisé par les fonctions GitHub de ROZA (pas un token).
#define GITHUB_USER "VOTRE_NOM_GITHUB"

// N2YO — clé API obtenue sur le site N2YO.
#define N2YO_API_KEY "COLLER_VOTRE_CLE_N2YO_ICI"

// Clash / Mihomo — URL de l'API du contrôleur et secret configuré dans Clash.
// Exemple de base : http://192.168.1.2:9090
#define CLASH_BASE "http://ADRESSE_IP_DU_SERVEUR:9090"
#define CLASH_SECRET "VOTRE_SECRET_CLASH"
#define CLASH_PROXY_GROUP "VOTRE_GROUPE_DE_PROXY"
