// Configuration locale ROZA.
// Copier ce fichier sous le nom config_local.h dans ce même dossier.
// config_local.h est ignoré par Git : ne jamais y mettre de mot de passe dans le dépôt.
//
// Les valeurs ci-dessous sont des exemples adaptés à une installation en France.
// Décommenter/modifier uniquement les paramètres que tu souhaites remplacer.
#pragma once

#define ROZA_LANGUAGE "FR"

#define CFG_NTP_1 "fr.pool.ntp.org"
#define CFG_NTP_2 "pool.ntp.org"
