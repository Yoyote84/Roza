CONFIG_IDF_TARGET="esp32s3"

# Carte : ESP32-S3FN8, 8 Mo de flash, aucune PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Fréquence nominale du Stamp-S3A.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Table de partitions ROZA dédiée.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000

# Tâche principale suffisamment dimensionnée pour l'initialisation du BSP.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# Optimisation de performance sans activer de mémoire PSRAM inexistante.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
